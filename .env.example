# Required security-sensitive configuration.
# Copy to .env (Node) and never commit real values.
# Worker deployments: secrets go via `npx wrangler secret put <NAME>`;
# local Worker development uses .dev.vars.

# Node/Worker shared ----------------------------------------------------------

# Database connection string (PostgreSQL / Neon).
DATABASE_URL=

# JWT signing secret for access and refresh tokens. REQUIRED in production;
# the app refuses to start without it (Worker: fails on first request).
JWT_SECRET=

# Node-only -------------------------------------------------------------------

# Node environment. When set to "production" a missing JWT_SECRET is fatal.
NODE_ENV=development

# Redis for caching and rate limiting (optional; caching degrades gracefully).
REDIS_URL=redis://localhost:6379

# Required by the tenant registration route (POST /tenants).
MASTER_APIKEY=

# Finecore payment provider API base URL.
FINECORE_BASE_URL=

# Public app URL used in outgoing links (password reset, invites).
FRONTEND_URL=

# Resend transactional email API key (optional; email sending is best-effort).
RESEND_API_KEY=

# Cloudflare R2 public CDN base URL for upload URLs (optional).
R2_PUBLIC_BASE_URL=

# Node R2 storage (S3-compatible) credentials for POST /upload.
# Without these the upload route returns a documented 503.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Worker-only -----------------------------------------------------------------
# The Worker reads the same DATABASE_URL / JWT_SECRET / R2_PUBLIC_BASE_URL.
# CACHE and R2_BUCKET_NAME are bindings configured in wrangler.jsonc;
# R2_PUBLIC_BASE_URL and other secrets are Worker env/secret vars.
